# ---------------------------------------------------------------------------
# BoliBazzar PRODUCTION
#
#   cp .env.prod.example .env.prod   # fill in EVERY value below
#   ./scripts/prod.sh up
#
# Generate secrets with:  openssl rand -hex 32
# Never reuse UAT values here, and never commit this file.
# ---------------------------------------------------------------------------

# --- domains (must already point at this server's IP) ----------------------
APP_DOMAIN=app.bolibazzar.in
LANDING_DOMAIN=bolibazzar.in
ADMIN_DOMAIN=admin.bolibazzar.in
# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=ops@bolibazzar.in

# --- database --------------------------------------------------------------
DB_NAME=bolibazzar
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
# Least-privilege user the application actually connects as.
MONGO_APP_USER=bolibazzar_app
MONGO_APP_PASSWORD=

# --- application secrets ---------------------------------------------------
# Signs buyer and supplier sessions. Rotating it logs everyone out.
SESSION_SECRET=
# Admin console requires BOTH an allowlisted email and this key.
ADMIN_EMAILS=
ADMIN_ACCESS_KEY=

# --- email (REQUIRED) ------------------------------------------------------
# Login codes are sent by email. Without a working SMTP transport, real users
# cannot sign in at all — the API returns 503 on the login endpoint.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BoliBazzar <no-reply@bolibazzar.in>"

# --- payments (REQUIRED for checkout) --------------------------------------
# Use LIVE keys here. Test-mode settlement is impossible when APP_ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI extraction ---------------------------------------------------------
# Without this the app falls back to a local keyword parser: it still works,
# but multilingual understanding degrades noticeably.
EMERGENT_LLM_KEY=
EMERGENT_LLM_BASE_URL=https://integrations.emergentagent.com/llm

# --- WhatsApp alerts to suppliers (optional) -------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=whatsapp:+14155238886

# --- behaviour -------------------------------------------------------------
AUCTION_WINDOW_SECONDS=120
# Must be false in production: seeded demo accounts must never bid against
# real buyers.
DEMO_BIDDERS=false

# --- mobile store links shown on the marketing site ------------------------
APP_STORE_URL=
PLAY_STORE_URL=

# --- ops -------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
IMAGE_TAG=prod
