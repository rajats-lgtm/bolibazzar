# ---------------------------------------------------------------------------
# BoliBazzar UAT environment
#
#   cp .env.uat.example .env.uat
#   # fill in the secrets below, then:
#   docker compose --env-file .env.uat -f docker-compose.uat.yml up -d --build
# ---------------------------------------------------------------------------

# Where testers reach the app. Use the machine's LAN IP or the UAT hostname —
# NOT localhost, or phones and other machines will not be able to reach it.
PUBLIC_BASE_URL=http://localhost:3000

# Every origin allowed to call the API. Sessions are cookie-based, so this
# cannot be "*". List the API, admin and landing origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

DB_NAME=bolibazzar_uat

# Ports published on the host.
API_PORT=3000
ADMIN_PORT=3001
LANDING_PORT=3002

# --- secrets (generate fresh ones for UAT; never reuse production) ----------
# Signs buyer and supplier sessions. Rotating it logs everyone out.
SESSION_SECRET=
# Admin console: BOTH the allowlisted email and this key are required.
ADMIN_EMAILS=admin@bolibazzar.in
ADMIN_ACCESS_KEY=

# --- integrations (optional; each degrades safely when blank) ---------------
EMERGENT_LLM_KEY=
EMERGENT_LLM_BASE_URL=https://integrations.emergentagent.com/llm
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# --- UAT behaviour ---------------------------------------------------------
# Return login codes in the API response so testers can sign in with no SMS or
# email provider. MUST be false in production.
OTP_DEV_MODE=true
# Settle payments without a gateway signature. Ignored when NODE_ENV=production.
PAYMENTS_TEST_MODE=true
# Seeded demo suppliers bid automatically, so the auction works before real
# suppliers exist. Set false to test a pure human marketplace.
DEMO_BIDDERS=true
AUCTION_WINDOW_SECONDS=120

# Store links shown on the marketing site (blank renders "Coming soon").
APP_STORE_URL=
PLAY_STORE_URL=
